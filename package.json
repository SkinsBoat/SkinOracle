{
  "name": "skin-oracle",
  "version": "0.1.32",
  "description": "Skin Oracle Desktop Trading Terminal",
  "author": {
    "name": "Skin Oracle",
    "email": "oracle@app.com"
  },
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win",
    "build:appx": "vite build && electron-builder --win appx",
    "build:linux": "vite build && electron-builder --linux",
    "build:all": "vite build && electron-builder --win --linux",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "organize-imports": "organize-imports-cli tsconfig.json",
    "cleanup": "organize-imports-cli tsconfig.json && prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "axios": "^1.6.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.39.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-is": "^19.2.8",
    "react-router-dom": "^6.20.0",
    "recharts": "^3.10.1",
    "sql.js": "^1.14.2",
    "tweetnacl": "^1.0.3",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "javascript-obfuscator": "^5.6.0",
    "organize-imports-cli": "^0.10.0",
    "prettier": "^3.9.6",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.15.5",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vitest": "^4.1.11",
    "wait-on": "^7.2.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.0.0"
  },
  "build": {
    "appId": "com.skinoracle.app",
    "productName": "Skin Oracle",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "SkinsBoat",
        "repo": "SkinOracle"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "appx"
      ],
      "icon": "assets/icon.png"
    },
    "appx": {
      "applicationId": "SkinOracle",
      "identityName": "SkinsBoat.SkinOracle",
      "publisher": "CN=6716DEEE-BC67-4415-A184-72E9DDD3FCE4",
      "publisherDisplayName": "SkinsBoat",
      "displayName": "Skin Oracle"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png"
    }
  }
}
